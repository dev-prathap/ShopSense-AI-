SHOPIFY_API_KEY=""
NEXT_PUBLIC_SHOPIFY_API_KEY=""   # Same value as SHOPIFY_API_KEY — exposed to client for App Bridge
SHOPIFY_API_SECRET=""
SHOPIFY_SCOPES="read_products,read_inventory,read_orders,read_customers"   # Must match access_scopes in shopify.app.toml — see the justification for each scope there
