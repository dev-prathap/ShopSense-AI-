NEXT_PUBLIC_THEME_EXTENSION_ID=""   # Theme app extension UUID from `shopify app deploy` output / Partner Dashboard. Optional: without it the "turn on the widget" link still opens the theme editor's App embeds panel, just without Neryn pre-selected
APP_SIGNING_SECRET=""
APP_AUTH_SECRET=""
CRON_SECRET=""
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
