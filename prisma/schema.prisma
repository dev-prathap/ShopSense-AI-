generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model Store {
  id                      String                   @id @default(cuid())
  shopDomain              String                   @unique
  accessToken             String
  installedAt             DateTime                 @default(now())
  uninstalledAt           DateTime?
  timezone                String                   @default("UTC")
  attributionWindowDays   Int                      @default(7)
  cartRecoveryDiscountPct Int                      @default(10)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  aiHandoffSensitivity    Int                      @default(50)
  aiMaxRecommendations    Int                      @default(3)
  aiTone                  String                   @default("concise_sales")
  recoveryEnabled         Boolean                  @default(true)
  handoffWebhookUrl       String?
  supportEmail            String?
  onboardingCompletedAt   DateTime?
  onboardingStep          Int                      @default(1)
  knowledgeReadyAt        DateTime?
  brandDescription        String?
  brandPersona            String?                  @default("Professional & Helpful")
  businessName            String?
  memberships             AppUserStoreMembership[]
  billingSubscription     BillingSubscription?
  conversations           Conversation[]
  customers               CustomerCache[]
  knowledgeChunks         KnowledgeChunk[]
  knowledgeSources        KnowledgeSource[]
  orders                  OrderCache[]
  products                Product[]
  variants                ProductVariant[]
  recommendationEvents    RecommendationEvent[]
  recoveryOffers          RecoveryOffer[]
  retryJobs               RetryJob[]
  users                   User[]
  webhookEvents           WebhookEvent[]
}

model AppUser {
  id           String                   @id @default(cuid())
  email        String                   @unique
  passwordHash String?
  name         String?
  authProvider String                   @default("credentials")
  googleSub    String?                  @unique
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  memberships  AppUserStoreMembership[]
}

model AppUserStoreMembership {
  id        String   @id @default(cuid())
  appUserId String
  storeId   String
  role      String   @default("owner")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  appUser   AppUser  @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([appUserId, storeId])
  @@index([storeId])
}

model User {
  id            String   @id @default(cuid())
  storeId       String
  email         String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  role          UserRole @default(OWNER)
  shopifyUserId String?
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, email])
  @@index([storeId, shopifyUserId])
}

model Product {
  id             String            @id @default(cuid())
  storeId        String
  shopifyId      String
  handle         String?
  title          String
  description    String
  category       String?
  price          Decimal           @db.Decimal(10, 2)
  currency       String            @default("USD")
  inStock        Boolean           @default(true)
  inventoryCount Int               @default(0)
  tags           String[]
  metadata       Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  store          Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  embeddings     ProductEmbedding?
  variants       ProductVariant[]

  @@unique([storeId, shopifyId])
  @@index([storeId, inStock])
  @@index([storeId, handle])
}

model ProductVariant {
  id               String   @id @default(cuid())
  storeId          String
  productId        String
  shopifyVariantId String
  inventoryItemId  String?
  title            String
  sku              String?
  price            Decimal  @db.Decimal(10, 2)
  inventoryQty     Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  store            Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, shopifyVariantId])
  @@index([storeId, inventoryItemId])
  @@index([productId])
}

model ProductEmbedding {
  id        String                @id @default(cuid())
  storeId   String
  productId String                @unique
  content   String
  embedding Unsupported("vector")
  createdAt DateTime              @default(now())
  product   Product               @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([productId])
}

model OrderCache {
  id                  String    @id @default(cuid())
  storeId             String
  shopifyOrderId      String
  orderNumber         String
  customerEmail       String?
  fulfillmentStatus   String?
  financialStatus     String?
  trackingNumber      String?
  trackingUrl         String?
  estimatedDeliveryAt DateTime?
  lastSyncedAt        DateTime  @default(now())
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  store               Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, shopifyOrderId])
  @@index([storeId, orderNumber])
}

model CustomerCache {
  id                String   @id @default(cuid())
  storeId           String
  shopifyCustomerId String
  email             String?
  firstName         String?
  lastName          String?
  phone             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  store             Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, shopifyCustomerId])
  @@index([storeId, email])
}

model Conversation {
  id                String                @id @default(cuid())
  storeId           String
  visitorId         String
  status            ConversationStatus    @default(OPEN)
  handoffReason     String?
  convertedAt       DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  handoffNotifiedAt DateTime?
  resolutionNote    String?
  resolvedAt        DateTime?
  store             Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  messages          Message[]
  recommendations   RecommendationEvent[]
  recoveryOffers    RecoveryOffer[]

  @@index([storeId, visitorId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String
  content        String
  confidence     Float?
  intent         String?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model RecommendationEvent {
  id                String       @id @default(cuid())
  storeId           String
  conversationId    String
  productId         String
  reason            String
  position          Int
  clickedAt         DateTime?
  convertedAt       DateTime?
  attributedRevenue Decimal?     @db.Decimal(10, 2)
  createdAt         DateTime     @default(now())
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  store             Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
  @@index([conversationId])
}

model RecoveryOffer {
  id             String       @id @default(cuid())
  storeId        String
  conversationId String
  offerCode      String
  discountPct    Int
  offeredAt      DateTime     @default(now())
  acceptedAt     DateTime?
  convertedAt    DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  store          Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, offeredAt])
}

model BillingSubscription {
  id               String           @id @default(cuid())
  storeId          String           @unique
  tier             SubscriptionTier @default(STARTER)
  trialEndsAt      DateTime
  active           Boolean          @default(true)
  externalChargeId String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  store            Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model WebhookEvent {
  id          String   @id @default(cuid())
  storeId     String
  eventKey    String
  topic       String
  processedAt DateTime @default(now())
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, eventKey])
  @@index([storeId, processedAt])
}

model RetryJob {
  id        String         @id @default(cuid())
  storeId   String
  type      String
  status    RetryJobStatus @default(PENDING)
  attempts  Int            @default(0)
  payload   Json?
  lastError String?
  nextRunAt DateTime       @default(now())
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  store     Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, status, nextRunAt])
}

model KnowledgeSource {
  id              String                @id @default(cuid())
  storeId         String
  type            KnowledgeSourceType
  url             String
  status          KnowledgeSourceStatus @default(PENDING)
  rawText         String?
  cleanText       String?
  summaryText     String?
  structuredFacts Json?
  checksum        String?
  lastFetchedAt   DateTime?
  approvedAt      DateTime?
  publishedAt     DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  chunks          KnowledgeChunk[]
  store           Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, type, url])
  @@index([storeId, type])
  @@index([storeId, status])
}

model KnowledgeChunk {
  id                String                @id @default(cuid())
  storeId           String
  knowledgeSourceId String
  content           String
  embedding         Unsupported("vector")
  chunkIndex        Int
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  knowledgeSource   KnowledgeSource       @relation(fields: [knowledgeSourceId], references: [id], onDelete: Cascade)
  store             Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([knowledgeSourceId, chunkIndex])
  @@index([storeId, knowledgeSourceId])
}

enum ConversationStatus {
  OPEN
  HANDOFF_REQUESTED
  RESOLVED
}

enum SubscriptionTier {
  STARTER
  GROWTH
  PRO
  ENTERPRISE
}

enum RetryJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum KnowledgeSourceType {
  PRIVACY
  SHIPPING
  RETURNS
  FAQ
  CONTACT
  CUSTOM
}

enum KnowledgeSourceStatus {
  PENDING
  FETCHED
  SUMMARIZED
  APPROVED
  PUBLISHED
  FAILED
}

enum UserRole {
  OWNER
  STAFF
}
